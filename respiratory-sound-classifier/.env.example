# Copy to .env and adjust. docker compose reads it automatically.

# Host port the web app is published on (nginx inside the frontend container)
HTTP_PORT=80

# IBM Z / LinuxONE (s390x) only - deploy/deploy.sh adds this automatically on s390x:
# COMPOSE_FILE=docker-compose.yml:docker-compose.s390x.yml

# IBM Db2 (screening history). Password of the db2inst1 user, used by the db2 and backend containers.
# deploy/deploy.sh replaces this placeholder with a random password on first run - never commit a real one.
DB2_PASSWORD=change-me
# Database name (max 8 characters). Changing it after the first start creates a new, empty database.
DB2_DBNAME=SCREEN

# Optional: plain-language explanations of each result by IBM Granite on watsonx.ai.
# Leave the key empty to turn them off - screening works the same without them. See DEPLOY.md.
# Never commit your real key: put it only in .env (which git ignores).
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-3-8b-instruct
# Language of the explanation in WhatsApp replies: en, ta (Tamil) or hi (Hindi)
WHATSAPP_LANGUAGE=en
