# Python ML inference service for IBM Z / LinuxONE (s390x).
# Build context is ./backend. Selected automatically by deploy/deploy.sh on s390x hosts
# (docker-compose.s390x.yml); x86_64 hosts use ./Dockerfile instead.
#
# Differences from the x86_64 image:
#  - numpy/scipy/scikit-learn/soxr/etc. come from Debian's s390x packages (PyPI has no s390x wheels)
#  - torch comes from PyTorch's official s390x CPU wheel (2.8.0 is the oldest one published)
#  - numba does not support s390x, so a pure-NumPy stand-in (numba_shim/) is installed for librosa.
#    It produces bit-identical features to real numba for this model's feature set.
FROM debian:trixie-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    MODEL_DIR=/app/model \
    PATH=/opt/venv/bin:$PATH

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 python3-venv libsndfile1 libopenblas0 \
        python3-numpy python3-scipy python3-sklearn python3-joblib python3-threadpoolctl \
        python3-soxr python3-soundfile python3-msgpack python3-pooch \
        python3-lazy-loader python3-decorator python3-typing-extensions \
        python3-standard-aifc python3-standard-sunau \
        python3-aiohttp python3-psutil python3-requests python3-tqdm python3-pyparsing \
        python3-xxhash python3-jinja2 python3-fsspec python3-sympy python3-networkx python3-filelock \
        python3-flask python3-flask-cors python3-gunicorn \
    && rm -rf /var/lib/apt/lists/*

# venv layered on top of the Debian packages, for the few wheels Debian doesn't ship
RUN python3 -m venv --system-site-packages /opt/venv

WORKDIR /app

COPY python_service/requirements-s390x.txt .
RUN pip install --no-deps --only-binary=:all: -r requirements-s390x.txt

COPY python_service/numba_shim/numba /tmp/numba
RUN mv /tmp/numba "$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')/numba" \
    && python -c "import numba, torch, torch_geometric, librosa, sklearn, flask, flask_cors, gunicorn; \
print('numba', numba.__version__, '| torch', torch.__version__, '| pyg', torch_geometric.__version__, \
'| librosa', librosa.__version__, '| numpy', __import__('numpy').__version__, '| sklearn', sklearn.__version__)"

COPY python_service/predict.py .
COPY python_service/model ./model

RUN useradd --system --uid 10001 appuser
USER appuser

EXPOSE 5001

HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:5001/health').status == 200 else 1)"

# `python -m gunicorn` so it runs inside the venv (Debian's /usr/bin/gunicorn would not see torch)
CMD ["python", "-m", "gunicorn", "--bind", "0.0.0.0:5001", "--workers", "1", "--threads", "4", "--timeout", "180", "predict:create_app()"]
